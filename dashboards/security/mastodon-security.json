      "title": "Config findings (High and Critical)",
      "description": "Risky workload settings such as running as root or privileged containers.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(trivy_resource_configaudits{cluster=\"$cluster\",severity=~\"High|Critical\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
