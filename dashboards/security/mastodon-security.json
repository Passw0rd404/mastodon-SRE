          "legendFormat": "401 unauthorized"
        },
        {
          "refId": "B",
          "expr": "sum(rate(traefik_router_requests_total{cluster=\"$cluster\",code=\"403\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "403 forbidden"
        },
        {
          "refId": "C",
          "expr": "sum(rate(traefik_router_requests_total{cluster=\"$cluster\",code=\"404\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "404 not found"
