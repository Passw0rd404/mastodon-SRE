    {
      "id": 23,
      "type": "table",
      "title": "Top 10 images by critical vulnerabilities",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "topk(10, sum by (image_repository, image_tag) (trivy_image_vulnerabilities{cluster=\"$cluster\",severity=\"Critical\"}))"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Critical CVEs",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "image_repository": "Image",
              "image_tag": "Tag",
              "Value": "Critical CVEs"
            }
          }
        }
      ]
    },
