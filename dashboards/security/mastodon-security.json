    {
      "id": 33,
      "type": "timeseries",
      "title": "Sign-in attempts (Traefik access log)",
      "description": "POST requests to /auth/sign_in. The first line is the total; the others are split by the status code Traefik returned.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "legendFormat": "all attempts",
          "expr": "sum(count_over_time({cluster=\"$cluster\", container=\"traefik\"} |= \"RequestPath\" | json | RequestPath = \"/auth/sign_in\" | RequestMethod = \"POST\" [$__interval])) or vector(0)"
        },
        {
          "refId": "B",
          "queryType": "range",
          "legendFormat": "status {{DownstreamStatus}}",
          "expr": "sum by (DownstreamStatus) (count_over_time({cluster=\"$cluster\", container=\"traefik\"} |= \"RequestPath\" | json | RequestPath = \"/auth/sign_in\" | RequestMethod = \"POST\" [$__interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
