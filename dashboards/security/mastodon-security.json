{
  "uid": "mastodon-security",
  "title": "Mastodon / Security",
  "description": "Runtime threats (Falco), image and configuration risk (Trivy), and suspicious traffic at the edge (Traefik).",
  "tags": [
    "mastodon",
    "security",
    "falco",
    "trivy"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds_mimir",
        "label": "Mimir",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "ds_loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds_mimir}"
        },
        "definition": "label_values(up, cluster)",
        "query": {
          "qryType": 1,
          "query": "label_values(up, cluster)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 90,
      "type": "text",
      "title": "About this dashboard",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Runtime alerts come from Falco, read from Loki. Image and configuration findings come from the Trivy operator. Edge signals come from Traefik metrics and access logs. On kind every Falco pod reports each event, so alerts without a pod name (`k8s_pod_name=<NA>`) are hidden here. On a real cluster remove that filter if you also want host-level alerts."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Falco alerts (selected range)",
      "description": "Runtime security alerts that name a pod. Duplicates from other kind nodes are hidden.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "(sum(count_over_time({cluster=\"$cluster\", container=\"falco\"} != \"k8s_pod_name=<NA>\" [$__range]))) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Critical vulnerabilities",
      "description": "Critical CVEs across all scanned container images.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_mimir}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(trivy_image_vulnerabilities{cluster=\"$cluster\",severity=\"Critical\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "High vulnerabilities",
      "description": "High-severity CVEs across all scanned container images.",
      "gridPos": {
        "h": 4,
        "w": 4,
